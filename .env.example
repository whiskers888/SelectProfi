# Copy to .env and replace each placeholder before running the production compose stack.

# Optional compose project name to avoid collisions with other local stacks
COMPOSE_PROJECT_NAME=selectprofi

# Generate URL-safe secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-generated-hex-secret
RABBITMQ_DEFAULT_USER=selectprofi
RABBITMQ_DEFAULT_PASS=replace-with-generated-hex-secret
JWT_SIGNING_KEY=replace-with-generated-hex-secret

# Optional remote PostgreSQL connection string. Keep the real value only in .env.
# POSTGRES_CONNECTION_STRING=Host=...;Database=...;Username=...;Password=...;SSL Mode=VerifyFull;Channel Binding=Require

BACKEND_PORT=5268
FRONTEND_PORT=5173

# Change the subnet and all proxy IPs together if the range overlaps with another Docker network.
PROXY_NETWORK_SUBNET=172.28.253.0/24
CADDY_PROXY_IP=172.28.253.2
FRONTEND_PROXY_IP=172.28.253.3
APP_PROXY_IP=172.28.253.4

# Set when the app requires S3-compatible storage.
# Supabase S3-compatible Storage. Keep access keys only in local env or Render.
S3__ENDPOINT=https://jebnbsehfrkmmvtqlqpa.storage.supabase.co/storage/v1/s3
S3__REGION=eu-west-3
S3__BUCKET=SelectProfiStorage
S3__ACCESSKEYID=
S3__SECRETACCESSKEY=
